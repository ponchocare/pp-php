{
  "name": "ponchopay/pp-php",
  "description": "Tools to integrate PonchoPay on PHP",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "files": [
      "src/token.php",
      "src/Utils/utils.php"
    ],
    "psr-4": {
      "PonchoPay\\": "src/"
    }
  },
  "authors": [
    {
      "name": "PonchoPay",
      "email": "info@ponchopay.com"
    }
  ],
  "require": {
    "php": "^8.2",
    "symfony/http-client": "^7.4 || ^8.0",
    "firebase/php-jwt": "^7.0",
    "psr/http-message": "^2.0"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.90",
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.3"
  },
  "extra": {
    "branch-alias": {
      "dev-main": "1.6.x-dev"
    }
  }
}
